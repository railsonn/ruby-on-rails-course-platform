- content_for :title, t("lessons.index.title")

.container.py-5

  / Aviso
  - if notice
    .alert.alert-success.border-0.shadow-sm.rounded-3.d-flex.align-items-center.mb-4
      %i.bi.bi-check-circle-fill.me-2
      = notice

  / Cabeçalho
  .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-5

    .d-flex.align-items-center.mb-3.mb-md-0
      .bg-primary-subtle.text-primary.rounded-circle.p-3.me-3
        %i.bi.bi-journal-text.fs-3

      %div
        %h1.fw-bold.text-dark.mb-1
          = t("lessons.index.title")

        %p.text-muted.mb-0
          Gerencie as aulas deste curso.

    = link_to new_course_lesson_path(@course),
      class: "btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" do
      %i.bi.bi-plus-lg.me-2
      = t("lessons.index.new")

  / Informações
  .card.border-0.shadow-sm.mb-4
    .card-body.p-3
      .d-flex.align-items-center
        .bg-light.rounded-circle.p-2.me-3
          %i.bi.bi-list-ul.text-primary

        %div
          %small.text-muted Total de aulas
          %h5.fw-bold.mb-0
            = @lessons.count

  / Lista de aulas
  %div#lessons
    - if @lessons.any?
      .row.g-4
        - @lessons.each do |lesson|
          .col-12.col-md-6.col-xl-4
            = render lesson

    - else
      .card.border-0.shadow-sm
        .card-body.text-center.py-5

          .bg-primary-subtle.text-primary.rounded-circle.d-inline-flex.p-4.mb-3
            %i.bi.bi-journal-x.fs-1

          %h4.fw-bold.text-dark
            Nenhuma aula encontrada

          %p.text-muted.mb-4
            = t("lessons.index.empty")

          = link_to new_course_lesson_path(@course),
            class: "btn btn-primary rounded-pill px-4" do
            %i.bi.bi-plus-lg.me-2
            Criar primeira aula