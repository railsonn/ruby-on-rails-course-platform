- content_for :title, t("lessons.index.title")

- if notice
  %p.alert.alert-success.text-center= notice

.container.mt-4
  .row
    .col-md-12.d-flex.justify-content-between.align-items-center.mb-3
      %h1= t("lessons.index.title")
      = link_to t("lessons.index.new"),
        new_course_lesson_path(@course),
        class: "btn btn-success"

  %hr

  %div#lessons
    - if @lessons.any?
      .row
        - @lessons.each do |lesson|
          .col-md-4.mb-3
            .card.shadow-sm
              .card-body
                = render lesson

              .card-footer.text-center
                = link_to t("lessons.index.show"),
                  [@course, lesson],
                  class: "btn btn-outline-success btn-sm"
    - else
      %p.text-muted.text-center= t("lessons.index.empty")
