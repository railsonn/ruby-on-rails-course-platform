- content_for :title, "Lessons"

- if notice
  %p.alert.alert-success.text-center= notice

.container.mt-4
  .row
    .col-md-12.d-flex.justify-content-between.align-items-center.mb-3
      %h1 Lessons
      = link_to "New lesson", new_lesson_path, class: "btn btn-success"

  %hr

  %div#lessons
    - if @lessons.any?
      .row
        - @lessons.each do |lesson|
          .col-md-4.mb-3
            .card.shadow-sm
              .card-body
                = render lesson

              .card-footer.text-center
                = link_to "Show this lesson", lesson, class: "btn btn-outline-success btn-sm"
    - else
      %p.text-muted.text-center No lessons found.
