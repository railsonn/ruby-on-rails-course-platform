.card.h-100.border-0.shadow-sm.overflow-hidden
  / Cabeçalho
  .card-header.border-0.text-white.p-4
    style="background: linear-gradient(135deg, #0d6efd, #6610f2);"

    .d-flex.align-items-center.justify-content-between
      .d-flex.align-items-center
        .bg-white.bg-opacity-25.rounded-circle.p-2.me-3
          %i.bi.bi-journal-text.fs-5

        %div
          %small.text-white.opacity-75
            Aula

          %h5.mb-0.fw-bold
            = link_to lesson.title,
              course_lesson_path(@course, lesson),
              class: "text-white text-decoration-none"

  / Conteúdo
  - if policy(lesson).show?
    .card-body.p-4
      %p.card-text.text-muted.mb-4
        = truncate(lesson.content, length: 180)

      .d-flex.align-items-center.text-muted.small
        %i.bi.bi-mortarboard-fill.me-2.text-primary
        %span
          = lesson.course

  / Ações
  - if policy(lesson).edit?
    .card-footer.border-0.p-4.pt-0
      .d-flex.gap-2

        = link_to edit_course_lesson_path(@course, lesson),
          class: "btn btn-warning btn-sm rounded-pill px-3 fw-semibold" do
          %i.bi.bi-pencil-square.me-1
          = t("lessons.card.edit")

        = button_to course_lesson_path(@course, lesson),
          method: :delete,
          data: { turbo_confirm: t("lessons.card.confirm_destroy") },
          class: "btn btn-danger btn-sm rounded-pill px-3 fw-semibold" do
          %i.bi.bi-trash3.me-1
          = t("lessons.card.destroy")