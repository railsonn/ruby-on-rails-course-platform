.card
  .card-header
    = link_to lesson.title, course_lesson_path(@course, lesson)

  - if policy(lesson).show?
    .card-body
      = lesson.content
      = lesson.course

  - if policy(lesson).edit?
    .card-footer.d-flex.gap-2
      = link_to t("lessons.card.edit"),
        edit_course_lesson_path(@course, lesson),
        class: "btn btn-sm btn-warning"

      = button_to t("lessons.card.destroy"),
        course_lesson_path(@course, lesson),
        method: :delete,
        data: { turbo_confirm: t("lessons.card.confirm_destroy") },
        class: "btn btn-sm btn-danger"
