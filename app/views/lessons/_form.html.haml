= form_with(model: lesson) do |form|
  - if lesson.errors.any?
    %div{style: "color: red"}
      %h2= "#{pluralize(lesson.errors.count, "error")} prohibited this lesson from being saved:"

      %ul
        - lesson.errors.each do |error|
          %li= error.full_message

  %div
    = form.label :title, style: "display: block"
    = form.text_field :title

  %div
    = form.label :content, style: "display: block"
    = form.textarea :content

  %div
    = form.label :course_id, style: "display: block"
    = form.text_field :course_id

  %div
    = form.submit
