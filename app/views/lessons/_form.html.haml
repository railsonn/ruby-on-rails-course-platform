= simple_form_for @lesson, html: { class: "card shadow-lg p-4 mt-4 border-0", style: "background: linear-gradient(135deg, #0d6efd, #6610f2); border-radius: 20px; color: white;" } do |form|
  - if @lesson.errors.any?
    .alert.alert-danger
      %h2.text-white= "#{pluralize(@lesson.errors.count, 'error')} prohibited this lesson from being saved:"
      %ul
        - @lesson.errors.each do |error|
          %li= error.full_message

  .mb-3
    = form.input :title, label: "Title", label_html: { class: "form-label fw-bold text-white" }, input_html: { class: "form-control rounded-pill shadow-sm" }

  .mb-3
    = form.input :content, as: :text, label: "Content", label_html: { class: "form-label fw-bold text-white" }, input_html: { class: "form-control shadow-sm", rows: 5 }

  .mb-3
    /= form.association :course, label: "Course", label_html: { class: "form-label fw-bold text-white" }, input_html: { class: "form-control shadow-sm" }
    = form.input :course_id, input_html: { value: @lesson.course_id || params[:course_id] }, as: :hidden


  .text-center.mt-4
    = form.button :submit, "Save Lesson", class: "btn btn-light fw-bold px-5 py-2 rounded-pill shadow"
