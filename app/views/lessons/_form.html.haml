= simple_form_for [:course, @lesson], html: { class: "card shadow-lg p-4 mt-4 border-0", style: "background: linear-gradient(135deg, #0d6efd, #6610f2); border-radius: 20px; color: white;" } do |form|
  - if @lesson.errors.any?
    .alert.alert-danger
      %h2.text-white= t('lessons.form.errors.header', count: @lesson.errors.count)
      %ul
        - @lesson.errors.each do |error|
          %li= error.full_message

  .mb-3
    = form.input :title,
      label: t('lessons.form.title'),
      label_html: { class: "form-label fw-bold text-white" },
      input_html: { class: "form-control rounded-pill shadow-sm" }

  .mb-3
    = form.input :content, label: t('lessons.form.content')
    %small= form.error :content, class: 'text-danger'

  .mb-3
    /= form.association :course, label: "Course", label_html: { class: "form-label fw-bold text-white" }, input_html: { class: "form-control shadow-sm" }
    = form.input :course_id, input_html: { value: @lesson.course_id || params[:course_id] }, as: :hidden

  .text-center.mt-4
    = form.button :submit, t('lessons.form.submit'), class: "btn btn-light fw-bold px-5 py-2 rounded-pill shadow"
