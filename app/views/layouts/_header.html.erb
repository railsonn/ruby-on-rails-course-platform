<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom shadow-sm">
  <div class="container-fluid">

    <!-- MARCA -->
    <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center" do %>
      <span class="bg-primary-subtle text-primary rounded-circle p-2 me-2">
        <i class="bi bi-gem"></i>
      </span>

      <%= t("navbar.brand") %>
    <% end %>

    <!-- BOTÃO MOBILE -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Alternar navegação">

      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

      <!-- LINKS -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- HOME -->
        <li class="nav-item">
          <%= link_to home_index_path,
            class: "nav-link #{'active fw-semibold' if current_page?(home_index_path) || current_page?(root_path)}" do %>

            <i class="bi bi-house me-1"></i>
            <%= t("navbar.links.home") %>

          <% end %>
        </li>

        <!-- CURSOS -->
        <li class="nav-item">
          <%= link_to courses_path,
            class: "nav-link #{'active fw-semibold' if current_page?(courses_path)}" do %>

            <i class="bi bi-journal-bookmark me-1"></i>
            <%= t("navbar.links.courses") %>

          <% end %>
        </li>

        <!-- NOVO CURSO -->
        <li class="nav-item">
          <%= link_to new_course_path,
            class: "nav-link #{'active fw-semibold' if current_page?(new_course_path)}" do %>

            <i class="bi bi-plus-circle me-1"></i>
            <%= t("navbar.links.new_course") %>

          <% end %>
        </li>

        <!-- USUÁRIOS -->
        <li class="nav-item">
          <%= link_to users_path,
            class: "nav-link #{'active fw-semibold' if current_page?(users_path)}" do %>

            <i class="bi bi-people me-1"></i>
            <%= t("navbar.links.users") %>

          <% end %>
        </li>

        <!-- ATIVIDADE -->
        <li class="nav-item">
          <%= link_to home_activity_path,
            class: "nav-link #{'active fw-semibold' if current_page?(home_activity_path)}" do %>

            <i class="bi bi-activity me-1"></i>
            <%= t("navbar.links.activity") %>

          <% end %>
        </li>

      </ul>

      <!-- PESQUISA -->
      <% if defined?(@ransack_courses) && @ransack_courses.present? %>

        <div class="me-lg-3 mb-3 mb-lg-0">

          <%= search_form_for @ransack_courses,
            as: :courses_search,
            url: courses_path do |f| %>

            <div class="input-group">

              <%= f.search_field :title_cont,
                class: "form-control",
                placeholder: t("navbar.search.placeholder"),
                autocomplete: "off",
                style: "max-width: 220px;" %>

              <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>
                <%= t("navbar.search.button") %>
              </button>

            </div>

          <% end %>

        </div>

      <% end %>

      <!-- USUÁRIO -->
      <% if current_user %>

        <ul class="navbar-nav">

          <li class="nav-item dropdown">

            <a
              class="nav-link dropdown-toggle d-flex align-items-center"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">

              <span class="bg-primary-subtle text-primary rounded-circle p-2 me-2">
                <i class="bi bi-person-circle"></i>
              </span>

              <span class="text-truncate" style="max-width: 180px;">
                <%= current_user.email %>
              </span>

            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">

              <li>
                <%= link_to edit_user_registration_path,
                  class: "dropdown-item py-2" do %>

                  <i class="bi bi-gear me-2"></i>
                  <%= t("navbar.user.account") %>

                <% end %>
              </li>

              <li>
                <hr class="dropdown-divider">
              </li>

              <li>
                <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "dropdown-item text-danger py-2" do %>

                  <i class="bi bi-box-arrow-right me-2"></i>
                  <%= t("navbar.user.logout") %>

                <% end %>
              </li>

            </ul>

          </li>

        </ul>

      <% else %>

        <!-- NÃO AUTENTICADO -->
        <div class="d-flex flex-column flex-lg-row gap-2">

          <%= link_to new_user_session_path,
            class: "btn btn-outline-primary rounded-pill px-3" do %>

            <i class="bi bi-box-arrow-in-right me-1"></i>
            <%= t("navbar.auth.login") %>

          <% end %>

          <%= link_to new_user_registration_path,
            class: "btn btn-primary rounded-pill px-3" do %>

            <i class="bi bi-person-plus me-1"></i>
            <%= t("navbar.auth.register") %>

          <% end %>

        </div>

      <% end %>

    </div>
  </div>
</nav>