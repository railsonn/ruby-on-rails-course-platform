<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">
      <i class="bi bi-gem me-1"></i>
      Rubygems
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <!-- LINKS PADRÃO -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item" if current_page?(root_path)>
          <%= link_to home_index_path, class: 'nav-link active' do %>
            <i class="bi bi-house me-1"></i>
            Home
          <% end %>
        </li>

        <li class="nav-item" if current_page?(courses_path)>
          <%= link_to courses_path(@course), class: 'nav-link active' do %>
            <i class="bi bi-journal-bookmark me-1"></i>
            Courses
          <% end %>
        </li>

        <li class="nav-item" if current_page?(new_course_path)>
          <%= link_to new_course_path, class: 'nav-link active' do %>
            <i class="bi bi-plus-circle me-1"></i>
            New course
          <% end %>
        </li>

        <li class="nav-item" if current_page?(users_path)>
          <%= link_to users_path, class: 'nav-link active' do %>
            <i class="bi bi-people me-1"></i>
            Users
          <% end %>
        </li>
      </ul>

      <!-- SEARCH IN NAVBAR -->
      <% if defined?(@ransack_courses) && @ransack_courses.present? %>
        <%= search_form_for @ransack_courses, as: :courses_search, url: courses_path do |f| %>
          <div class="input-group">
            <%= f.search_field :title_cont,
              class: "form-control-sm",
              style: "float: left; width: 150px;",
              placeholder: "Find a course",
              autocomplete: "off" %>

            <span class="input-group-append">
              <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-search me-1"></i>
                <span aria-hidden="true">Search</span>
              </button>
            </span>
          </div>
        <% end %>

        <ul class="navbar-nav mr-right">
          <li class="nav-item" if current_page?(home_activity_path)>
            <%= link_to home_activity_path, class: 'nav-link active' do %>
              <i class="bi bi-activity me-1"></i>
              Activity
            <% end %>
          </li>

          <li class="nav-item <%= 'active font-weight-bold' if current_page?(root_path) %>">
            <%= link_to root_path, class: "nav-link" do %>
              <i class="bi bi-house-door me-1"></i>
              Home
            <% end %>
          </li>
        </ul>

        <!-- DROPDOWN DO USUÁRIO -->
        <% if current_user %>
          <ul class="navbar-nav">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i>
                <%= current_user.email %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li>
                  <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                    <i class="bi bi-gear me-1"></i>
                    Minha conta
                  <% end %>
                </li>
                <li>
                  <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Logout
                  <% end %>
                </li>
              </ul>
            </li>
          </ul>
        <% end %>

      <% else %>
        <!-- QUANDO NÃO ESTÁ LOGADO -->
        <div class="d-flex">
          <%= link_to new_user_session_path, class: "btn btn-outline-primary me-2" do %>
            <i class="bi bi-box-arrow-in-right me-1"></i>
            Log in
          <% end %>

          <%= link_to new_user_registration_path, class: "btn btn-primary" do %>
            <i class="bi bi-person-plus me-1"></i>
            Register
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
