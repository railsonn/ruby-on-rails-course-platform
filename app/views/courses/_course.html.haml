.container.d-flex.justify-content-center.mt-4
  .card.shadow-lg(style="width: 70%;")

    .card-header.text-center
      .fa.fa-book
      = link_to course.title, courses_path(@courses)

    .card-body
      = course.description
      %small= simple_format(course.short_description)

    .card-footer.text-center
      = number_to_currency(course.price)

    .card-footer
      .row
        .col-md-6
          .fa.fa-signal
          = course.language
        .col-md-6.text-right
          .fa.fa-envelope
          = course.level



    .card-footer
      .row
        .col-md-6
          .far.fa-clock
          = course.created_at.strftime('%d-%b-%Y')
        .col-md-6.text-right
          .fa.fa-chalkboard-teacher
          = course.user.username

    - if policy(course).edit?
      .card-footer.text-center
        = link_to 'Edit', edit_course_path(course), class: 'btn btn-sm btn-warning'
        /- if policy(course).edit?
        = link_to 'Destroy', course, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger'
        /-  if policy(course).destroy?
        