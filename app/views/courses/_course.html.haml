.container.d-flex.justify-content-center.mt-4
  .card.shadow-lg(style="width: 70%;")

    .card-header.text-center
      %i.bi.bi-book.me-1
      = link_to course.title, course_path(course)

    .card-body
      = course.description
      %small= simple_format(course.short_description)

    .card-footer.text-center
      %i.bi.bi-currency-dollar.me-1
      = number_to_currency(course.price)
  
    .card-footer
      %i.bi.bi-journal-text.me-1
      = course.lessons.count

    .card-footer
      .row
        .col-md-6
          %i.bi.bi-signal.me-1
          = course.language
        .col-md-6.text-right
          %i.bi.bi-bar-chart.me-1
          = course.level

    .card-footer
      .row
        .col-md-6
          %i.bi.bi-clock.me-1
          = course.created_at.strftime('%d-%b-%Y')
        .col-md-6.text-right
          %i.bi.bi-person-workspace.me-1
          = link_to course.user.username, user_path(course.user)

    - if current_user
      - if policy(course).edit?
        .card-footer.text-center.d-flex.justify-content-center.gap-2
          = link_to edit_course_path(course), class: 'btn btn-sm btn-warning' do
            %i.bi.bi-pencil-square.me-1
            Edit

          - if course.user_id == current_user.id
            = button_to "Destroy",
              course,
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "btn btn-sm btn-danger"

          