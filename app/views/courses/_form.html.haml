= simple_form_for @course, html: { class: "card shadow-lg p-4 mt-4 border-0", style: "background: linear-gradient(135deg, #0d6efd, #6610f2); border-radius: 20px; color: white;" } do |f|

  - if @course.errors.any?
    %div.alert.alert-danger
      %h2.text-white= t('courses.form.errors.header', count: @course.errors.count)

      %ul
        - @course.errors.each do |error|
          %li= error.full_message

  %div.mb-3
    = f.input :title,
      label: t('courses.form.title'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control rounded-pill shadow-sm" }

  %div.mb-3

    = f.input :description,
      as: :text,
      label: t('courses.form.description'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control shadow-sm", rows: 4 }

    = f.input :short_description,
      label: t('courses.form.short_description'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control shadow-sm", rows: 4 }

    = f.input :language,
      collection: ["english", "polish", "russia"],
      label: t('courses.form.language'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control shadow-sm" }

    = f.input :level,
      collection: ["begginer", "intermediario", "advanced"],
      label: t('courses.form.level'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control shadow-sm" }

    = f.input :price,
      label: t('courses.form.price'),
      label_html: { class: "form-label fw-bold" },
      input_html: { class: "form-control shadow-sm" }

  %div.text-center.mt-4
    = f.button :submit, t('courses.form.submit'), class: "btn btn-light fw-bold px-5 py-2 rounded-pill shadow"
