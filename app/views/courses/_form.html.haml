.container.py-5

  .row.justify-content-center
    .col-lg-8

      .card.border-0.shadow-lg.rounded-4.overflow-hidden

        / Header
        .p-4.text-white{style: "background: linear-gradient(135deg, #667eea, #764ba2);"}

          %h2.fw-bold.mb-1
            %i.bi.bi-mortarboard-fill.me-2
            = t('courses.form.header')

          %p.mb-0.opacity-75
            Crie e configure as informações do curso


        .card-body.p-5

          - if @course.errors.any?
            .alert.alert-danger.rounded-3.shadow-sm

              %h5.fw-bold
                = t('courses.form.errors.header', count: @course.errors.count)

              %ul.mb-0
                - @course.errors.each do |error|
                  %li= error.full_message


          = simple_form_for @course do |f|

            .mb-4
= simple_form_for @course do |f|

  .mb-4
    = f.input :title,
      label: t('courses.form.title'),
      label_html: { class: "form-label fw-semibold" },
      input_html: { class: "form-control form-control-lg rounded-3 shadow-sm", placeholder: "Digite o título do curso" }


  .mb-4
    = f.input :short_description,
      label: t('courses.form.short_description'),
      input_html: { class: "form-control rounded-3 shadow-sm", rows: 3, placeholder: "Uma breve descrição do curso" }

  .mb-4
    = f.input :description,
      as: :text,
      label: t('courses.form.description'),
      label_html: { class: "form-label fw-semibold" },
      input_html: { class: "form-control rounded-3 shadow-sm", rows: 5, placeholder: "Descrição completa do curso" }


  .row

    .col-md-6.mb-4
      = f.input :language,
        collection: ["English", "Português", "Polski"],
        label: t('courses.form.language'),
        label_html: { class: "form-label fw-semibold" },
        input_html: { class: "form-select rounded-3 shadow-sm" }


    .col-md-6.mb-4
      = f.input :level,
        collection: ["Beginner", "Intermediate", "Advanced"],
        label: t('courses.form.level'),
        label_html: { class: "form-label fw-semibold" },
        input_html: { class: "form-select rounded-3 shadow-sm" }


  .mb-4
    = f.input :price,
      label: t('courses.form.price'),
      label_html: { class: "form-label fw-semibold" },
      input_html: { class: "form-control rounded-3 shadow-sm", placeholder: "R$ 0,00" }


  .text-center.mt-4
    = f.button :submit,
      t('courses.form.submit'),
      class: "btn btn-primary btn-lg px-5 rounded-pill shadow"