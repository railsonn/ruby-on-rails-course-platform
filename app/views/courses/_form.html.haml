= form_with(model: @course, class: "card shadow-lg p-4 mt-4 border-0", style: "background: linear-gradient(135deg, #0d6efd, #6610f2); border-radius: 20px; color: white;") do |form|
  - if @course.errors.any?
    %div.alert.alert-danger
      %h2.text-white= "#{pluralize(@course.errors.count, 'error')} prohibited this course from being saved:"

      %ul
        - @course.errors.each do |error|
          %li= error.full_message

  %div.mb-3
    = form.label :title, class: "form-label fw-bold"
    = form.text_field :title, class: "form-control rounded-pill shadow-sm"

  %div.mb-3
    = form.label :description, class: "form-label fw-bold"
    = form.textarea :description, class: "form-control shadow-sm", rows: 4

  %div.text-center.mt-4
    = form.submit "Save Course", class: "btn btn-light fw-bold px-5 py-2 rounded-pill shadow"
