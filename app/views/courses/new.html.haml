- content_for :title, "New course"

.container.py-5

  .row.justify-content-center
    .col-lg-8

      .card.border-0.shadow-lg.rounded-4.overflow-hidden

        .card-header.text-white.border-0.p-4{style: "background: linear-gradient(135deg, #667eea, #764ba2);"}

          %h1.fw-bold.mb-1
            %i.bi.bi-plus-circle-fill.me-2
            New course

          %p.mb-0.opacity-75
            Crie um novo curso e compartilhe conhecimento


        .card-body.p-5.bg-white

          = render 'form'


      .text-center.mt-4

        = link_to courses_path,
          class: "btn btn-outline-secondary rounded-pill px-4" do

          %i.bi.bi-arrow-left.me-2
          Back