%p.alert.alert-success.rounded-3.shadow-sm= notice if notice

- content_for :title, t('courses.index.title')

.container-fluid.py-4

  .row.g-4

    / Filtros
    .col-lg-3

      .card.border-0.shadow-sm.rounded-4

        .card-header.text-white.border-0.rounded-top-4{style: "background: linear-gradient(135deg, #667eea, #764ba2);"}

          %h5.mb-0.fw-bold
            %i.bi.bi-funnel-fill.me-2
            Filtros


        .card-body

          = search_form_for @ransack_courses, as: :courses_search, url: courses_path do |f|

            .mb-3
              = f.label :title, t('courses.index.search.title'), class: "form-label fw-semibold"

              = f.search_field :title_cont,
                placeholder: t('courses.index.placeholders.title'),
                class: "form-control rounded-3"


            .mb-3
              = f.label :description, t('courses.index.search.description'), class: "form-label fw-semibold"

              = f.search_field :short_description_cont,
                placeholder: t('courses.index.placeholders.description'),
                class: "form-control rounded-3"


            .mb-3
              = f.label :language, t('courses.index.search.language'), class: "form-label fw-semibold"

              = f.select :language_cont,
                Course.languages,
                { include_blank: "Todos" },
                class: "form-select rounded-3"


            .mb-3
              = f.label :level, t('courses.index.search.level'), class: "form-label fw-semibold"

              = f.select :level_cont,
                Course.levels,
                { include_blank: "Todos" },
                class: "form-select rounded-3"


            .mb-3
              = f.label :price, t('courses.index.search.price'), class: "form-label fw-semibold"

              = f.search_field :price_eq,
                placeholder: t('courses.index.placeholders.price'),
                class: "form-control rounded-3"


            .mb-3
              = f.label :teacher, t('courses.index.search.teacher'), class: "form-label fw-semibold"

              = f.search_field :user_email_cont,
                placeholder: t('courses.index.placeholders.email'),
                class: "form-control rounded-3"


            = f.submit t('courses.index.search.submit'),
              class: "btn btn-primary w-100 rounded-pill shadow"


          = link_to t('courses.index.search.refresh'),
            courses_path,
            class: "btn btn-outline-secondary w-100 mt-3 rounded-pill"



    / Lista de cursos
    .col-lg-9


      .card.border-0.shadow-sm.rounded-4

        .card-header.bg-white.border-0.p-4

          .d-flex.justify-content-between.align-items-center

            %div

              %h1.h3.fw-bold.mb-1
                %i.bi.bi-mortarboard-fill.me-2.text-primary
                = t('courses.index.title')


              %span.text-muted
                = t('courses.index.quantity')
                %strong= @quant


        .card-body.p-4

          %div.row.g-4{id: "courses"}

            - @courses.each do |course|

              .col-md-6

                = render "course", course: course