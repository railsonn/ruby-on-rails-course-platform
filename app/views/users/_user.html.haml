.card.h-100.shadow-sm.border-0.overflow-hidden.mx-auto{ style: "max-width: 600px;" }

  / Cabeçalho
  .card-header.border-0.text-white.p-4{ style: "background: linear-gradient(135deg, #6f42c1, #0d6efd);" }

    .d-flex.align-items-center.justify-content-between

      .d-flex.align-items-center
        .bg-white.bg-opacity-25.rounded-circle.p-2.me-3
          %i.bi.bi-person-circle.fs-4

        %div
          %small.text-white.opacity-75
            Usuário

          %h5.mb-1.fw-bold
            = link_to user.email,
              user_path(user),
              class: "text-white text-decoration-none"

          - if user.online?
            %span.badge.bg-success.bg-opacity-75
              %i.bi.bi-circle-fill.me-1
              = t("users.card.status.online")
          - else
            %span.badge.bg-danger.bg-opacity-75
              %i.bi.bi-circle-fill.me-1
              = t("users.card.status.offline")

  / Informações da conta
  .card-body.p-4

    .d-flex.align-items-center.mb-3
      .bg-primary-subtle.text-primary.rounded-circle.p-2.me-3
        %i.bi.bi-calendar-check

      %div
        %small.text-muted
          = t("users.card.signed_up")

        %div.fw-semibold.text-dark
          = time_ago_in_words(user.created_at)
          = t("users.card.ago")

    %hr.my-4

    / Atividade
    %h6.fw-bold.text-dark.mb-3
      %i.bi.bi-activity.me-2.text-primary
      Atividade da conta

    .row.g-3

      .col-12.col-md-6
        .bg-light.rounded-3.p-3.h-100
          %small.text-muted.d-block
            %i.bi.bi-box-arrow-in-right.me-1
            = t("users.card.fields.sign_in_count")

          %span.fw-bold.fs-5
            = user.sign_in_count

      .col-12.col-md-6
        .bg-light.rounded-3.p-3.h-100
          %small.text-muted.d-block
            %i.bi.bi-clock-history.me-1
            = t("users.card.fields.current_sign_in_at")

          %span.fw-semibold
            = user.current_sign_in_at.present? ? l(user.current_sign_in_at) : "Nunca fez login"

      .col-12.col-md-6
        .bg-light.rounded-3.p-3.h-100
          %small.text-muted.d-block
            %i.bi.bi-clock.me-1
            = t("users.card.fields.last_sign_in_at")

          %span.fw-semibold
            = user.last_sign_in_at.present? ? l(user.last_sign_in_at) : "Nunca fez login"

      .col-12.col-md-6
        .bg-light.rounded-3.p-3.h-100
          %small.text-muted.d-block
            %i.bi.bi-pc-display.me-1
            = t("users.card.fields.current_sign_in_ip")

          %span.fw-semibold
            = user.current_sign_in_ip || "Não disponível"

      .col-12.col-md-6
        .bg-light.rounded-3.p-3.h-100
          %small.text-muted.d-block
            %i.bi.bi-hdd-network.me-1
            = t("users.card.fields.last_sign_in_ip")

          %span.fw-semibold
            = user.last_sign_in_ip || "Não disponível"

    %hr.my-4

    / Confirmação
    .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
      .d-flex.align-items-center
        .bg-primary-subtle.text-primary.rounded-circle.p-2.me-2
          %i.bi.bi-patch-check

        %span.fw-semibold
          = t("users.card.confirmation.label")

      - if user.confirmed_at.present?
        %span.badge.text-bg-success.rounded-pill.px-3.py-2
          %i.bi.bi-check-circle.me-1
          = t("users.card.confirmation.yes")
      - else
        %span.badge.text-bg-danger.rounded-pill.px-3.py-2
          %i.bi.bi-x-circle.me-1
          = t("users.card.confirmation.no")

  / Rodapé
  .card-footer.bg-white.border-0.p-4

    .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3

      / Funções
      .d-flex.flex-wrap.gap-2
        - user.roles.each do |role|
          %span.badge.text-bg-primary.rounded-pill.px-3.py-2
            %i.bi.bi-shield-lock.me-1
            = t("roles.#{role.name}", default: role.name)

      / Ações
      - if policy(user).edit?
        = link_to edit_user_path(user),
          class: "btn btn-warning btn-sm rounded-pill px-3 fw-semibold" do
          %i.bi.bi-pencil-square.me-1
          = t("users.card.actions.edit_roles")