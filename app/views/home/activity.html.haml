%h3
  .text-center
    Activity
    .badge.badge-info
      = @activities.count

%ul{ class: "list-group" }
  - @activities.each do |activity|
    %li{ class: "list-group-item" }
      = activity.id
      = activity.trackable_type
      = activity.trackable.id
      = link_to activity.trackable, activity.trackable
      = activity.key
      = activity.parameters
      = activity.owner
