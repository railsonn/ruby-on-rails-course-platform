.container.py-4
  .d-flex.justify-content-between.align-items-center.mb-4
    .d-flex.align-items-center
      .bg-primary.text-white.rounded-circle.p-2.me-3
        %i.bi.bi-activity.fs-4

      %div
        %h3.mb-0.fw-bold Atividades
        %small.text-muted Histórico de atividades

    %span.badge.bg-info.text-dark.fs-6.px-3.py-2
      %i.bi.bi-list-ul.me-1
      = @activities.count

  - if @activities.any?
    .row.g-3
      - @activities.each do |activity|
        .col-12
          .card.border-0.shadow-sm.rounded-3
            .card-body

              .d-flex.justify-content-between.align-items-start.mb-3
                .d-flex.align-items-center
                  .bg-light.rounded-circle.p-2.me-3
                    %i.bi.bi-activity.text-primary.fs-5

                  %div
                    %h5.mb-1.fw-semibold
                      = "Atividade ##{activity.id}"

                    %small.text-muted
                      = activity.key

                - if activity.created_at.present?
                  %span.badge.bg-light.text-secondary
                    %i.bi.bi-clock.me-1
                    = activity.created_at.strftime("%d/%m/%Y %H:%M")

              .row.g-3
                .col-md-4
                  .text-muted.small.mb-1
                    %i.bi.bi-diagram-3.me-1
                    Tipo do registro

                  %span.badge.bg-primary-subtle.text-primary
                    = activity.trackable_type || "N/A"

                .col-md-4
                  .text-muted.small.mb-1
                    %i.bi.bi-hash.me-1
                    ID do registro

                  %span.badge.bg-secondary-subtle.text-secondary
                    = activity.trackable_id || "N/A"

                .col-md-4
                  .text-muted.small.mb-1
                    %i.bi.bi-person-circle.me-1
                    Responsável

                  %span.text-dark
                    = activity.owner || "Sistema"

              .mt-3.pt-3.border-top
                .text-muted.small.mb-2
                  %i.bi.bi-link-45deg.me-1
                  Registro relacionado

                - if activity.trackable.present?
                  .d-flex.align-items-center
                    %span.badge.bg-primary-subtle.text-primary.me-2
                      = activity.trackable_type

                    %span.text-dark
                      = "##{activity.trackable_id}"
                - else
                  %span.text-muted
                    Registro não disponível

              - if activity.parameters.present?
                .mt-3
                  .text-muted.small.mb-2
                    %i.bi.bi-braces.me-1
                    Parâmetros

                  %pre.bg-light.border.rounded.p-3.mb-0.small
                    = activity.parameters

  - else
    .card.border-0.shadow-sm.rounded-3
      .card-body.text-center.py-5
        %i.bi.bi-inbox.fs-1.text-muted

        %h5.mt-3.fw-semibold
          Nenhuma atividade encontrada

        %p.text-muted.mb-0
          Ainda não existem atividades registradas.